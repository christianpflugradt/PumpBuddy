{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "internalChecksFilter": "strict",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "rebaseWhen": "behind-base-branch",
  "extends": [
    "config:best-practices"
  ],
  "packageRules": [
    {
      "description": "Wait seven days before routine dependency update PRs to reduce fresh-release supply-chain risk.",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Wait fourteen days before major dependency update PRs because they carry higher change and review risk.",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track OpenAPI generator image in Makefile",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "OPENAPI_GENERATOR_IMAGE \\?= (?<depName>[^\\s]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track workflow Python runtime versions",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "python-version:\\s*['\"]?(?<currentValue>\\d+(?:\\.\\d+){0,2})['\"]?"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "pep440"
    },
    {
      "customType": "regex",
      "description": "Track repository Node.js toolchain version",
      "managerFilePatterns": [
        "/(^|/)\\.node-version$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\d+(?:\\.\\d+){0,2})$"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "Track workflow Node.js runtime versions",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "node-version:\\s*['\"]?(?<currentValue>\\d+(?:\\.\\d+){0,2})['\"]?"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ]
}
