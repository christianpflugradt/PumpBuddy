{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "internalChecksFilter": "strict",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "rebaseWhen": "behind-base-branch",
  "automerge": false,
  "platformAutomerge": false,
  "minimumReleaseAge": "7 days",
  "extends": [
    "config:best-practices",
    ":maintainLockFilesMonthly",
    "github>christianpflugradt/please-behave-governance:renovate-governor",
    "github>christianpflugradt/please-behave-governance:renovate-content-aware"
  ],
  "packageRules": [
    {
      "description": "Auto-merge patch, minor, and digest dependency updates after green CI.",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Wait fourteen days before major dependency update PRs because they carry higher change and review risk.",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "!please-behave/cli",
        "!please-behave/action"
      ]
    },
    {
      "description": "Group non-major GitHub Actions updates and apply a fourteen-day cooldown; major updates stay manual.",
      "matchFileNames": [
        ".github/**"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "groupName": "github-actions",
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "!please-behave/action"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track OpenAPI generator image in Makefile",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "OPENAPI_GENERATOR_IMAGE \\?= (?<depName>[^\\s:@]+(?:/[^\\s:@]+)*):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track workflow Python runtime versions",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "python-version:\\s*['\"]?(?<currentValue>\\d+(?:\\.\\d+){0,2})['\"]?"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "pep440"
    }
  ]
}
