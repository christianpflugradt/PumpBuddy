# Required: image tag published to GHCR for both backend and renderer
APP_VERSION=v1.2.3

# Required: PostgreSQL password used by postgres and backend
POSTGRES_PASSWORD=replace-with-strong-secret

# Recommended: stable compose project name so service/volume names stay consistent across updates
COMPOSE_PROJECT_NAME=pumpbuddy

# Required for production safety: pre-created persistent docker volume name for postgres data
POSTGRES_VOLUME_NAME=pumpbuddy-postgres-data
