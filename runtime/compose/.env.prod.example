# Required: image tag published to GHCR for both backend and renderer
APP_VERSION=v1.2.3

# Required: PostgreSQL password used by postgres and backend
POSTGRES_PASSWORD=replace-with-strong-secret

# Optional: GHCR owner/org (defaults to christianpflugradt)
# GHCR_OWNER=christianpflugradt

# Optional: initial seeded user metadata
# INIT_USER_ID=00000000-0000-0000-0000-000000000001
# INIT_LOGIN_NAME=admin
# INIT_DISPLAY_NAME=Primary User
# ACCESS_KEY_LENGTH=32
