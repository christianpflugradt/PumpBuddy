:80

root * /srv
encode zstd gzip

@api path /api/*
header @api {
	Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	Pragma "no-cache"
	Expires "0"
}
reverse_proxy @api backend:8080

@auth path /auth/*
header @auth {
	Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	Pragma "no-cache"
	Expires "0"
}
reverse_proxy @auth backend:8080

@immutable_build_assets path /assets/*
header @immutable_build_assets Cache-Control "public, max-age=31536000, immutable"

@app_shell path / /index.html /favicon.ico /favicon.png /apple-touch-icon.png /manifest.webmanifest /icon.png /icon-192.png /icon-512.png /images/*
header @app_shell {
	Cache-Control "no-cache, must-revalidate"
	Pragma "no-cache"
	Expires "0"
}

